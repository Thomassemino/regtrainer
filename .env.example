DATABASE_URL=postgresql://beto:changeme@db:5432/beto_training
POSTGRES_PASSWORD=changeme
AUTH_SECRET=
# AUTH_TRUST_HOST=true  # Self-host detrás de proxy inverso: trustHost ya está habilitado en el código (lib/auth.ts), no hace falta setearlo aquí.
NEXTAUTH_URL=http://localhost:3000
SMTP_HOST=smtp
SMTP_PORT=25
# TRUST_PROXY=0  # Sólo ponelo en 1 si la app corre detrás de un proxy inverso confiable (Nginx/Caddy) que sobrescribe X-Forwarded-For / X-Real-IP con la IP real del cliente. Sin esto la app ignora esos headers (IP "unknown").
SMTP_FROM="Beto Training <no-reply@betotraining.com.ar>"
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
SEED_ADMIN_EMAIL=beto@betotraining.com.ar
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
# Mercado Pago: dejá vacío para probar local sin pagos reales (el e2e de MP queda skip).
# Usá credenciales de prueba (TEST-...) del panel de Developers para activar el e2e de sandbox.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=